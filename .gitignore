# Virtual environments (never commit)
.venv/
venv/
venv-space/
env/

# Caches and bytecode
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Build / packaging artifacts
*.egg-info/
dist/
build/

# Python path files (auto-generated by tools)
.python-version
uv.lock
# If you later add heavy binary caches:
*.joblib

# Environment and secrets (never commit values)
.env
.env.local
.env.*.local
.env.*.bak
*.env
*.token
secrets/
secrets.json
secrets.toml

# OS junk
Thumbs.db
.DS_Store
desktop.ini

# Freebuff project marker is outside project control; keep it out of version control
.freebuff/

# Runtime logs (optional; delete before commit if not needed)
*.log

# Frontend (React + Vite)
/frontend/node_modules/
/frontend/dist/
/frontend/.env.local
/frontend/.env

